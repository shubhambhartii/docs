{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "techcreamblog",
  "colors": {
    "primary": "#0D7FF2",
    "light": "#07C983",
    "dark": "#1C3F60"
  },
  "favicon": "/favicon.svg",
